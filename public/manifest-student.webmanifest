{
  "id": "/?hungry_app=student",
  "name": "Hungry",
  "short_name": "Hungry",
  "description": "Order campus food as a student, faculty member, or guest.",
  "start_url": "/auth?hungry_app=student",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "background_color": "#050505",
  "theme_color": "#e60012",
  "related_applications": [
    { "platform": "webapp", "id": "/?hungry_app=student", "url": "/manifest-student.webmanifest" },
    { "platform": "webapp", "id": "/?hungry_app=canteen", "url": "/manifest-canteen.webmanifest" }
  ],
  "icons": [
    { "src": "/pwa-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/pwa-icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/pwa-icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ]
}
