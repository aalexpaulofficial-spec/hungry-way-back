# =====================================================================
# HUNGRY — environment variables (copy names only; never commit real secrets)
# Full guide: docs/SETUP.md
#
# PUBLIC values (safe in the browser) start with VITE_.
# SECRET values must ONLY be stored as backend secrets
# (Lovable: Project Settings → Secrets · other hosts: their environment settings).
# =====================================================================

# --- Supabase (Supabase dashboard → Project Settings → API) ---------
# Project URL, e.g. https://abcdefghijkl.supabase.co
VITE_SUPABASE_URL=
SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy "anon public" key
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
# Project reference id (the "abcdefghijkl" part of the URL)
VITE_SUPABASE_PROJECT_ID=
SUPABASE_PROJECT_ID=
# SECRET — service_role / sb_secret_ key. Server only. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (Razorpay Dashboard → Account & Settings → API Keys) ---
# Use TEST keys (rzp_test_...) until you have verified everything.
RAZORPAY_KEY_ID=
# SECRET
RAZORPAY_KEY_SECRET=
# SECRET — the value you type in Razorpay → Webhooks → Secret
RAZORPAY_WEBHOOK_SECRET=

# --- Gmail SMTP (sender for all HUNGRY emails) ------------------------
GMAIL_USER=hungryofficialx@gmail.com
# SECRET — 16-character Google App Password (Google Account → Security → App passwords)
GMAIL_APP_PASSWORD=

# --- Admin dashboard (/admin) -----------------------------------------
# SECRET — password for the admin login (admin email is set in code)
ADMIN_PASSWORD=
